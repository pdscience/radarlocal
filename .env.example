# Public frontend variables (Vite). The anon key is safe in the browser.
VITE_INSFORGE_URL="https://YOUR_PROJECT.REGION.insforge.app"
VITE_INSFORGE_ANON_KEY="YOUR_ANON_KEY"

# Server-only values. Set OPENROUTER_API_KEY as an InsForge secret, never as VITE_*.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
# Optional: override the model used for public lookups (default: google/gemini-2.5-flash:online).
OPENROUTER_MODEL="google/gemini-2.5-flash:online"
APP_ORIGIN="http://localhost:5173"
APP_URL="MY_APP_URL"
